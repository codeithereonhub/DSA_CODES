    *head = newPassenger;

    // Mark the seat as booked
    seats[seatIndex] = 1;

    cout << "Ticket booked successfully! Seat No: "
         << seatIndex + 1 << "\n";
}

// Function to cancel a ticket
void cancelTicket(int* seats, Passenger** head)
{
    int seatNo;

    cout << "Enter Seat Number to Cancel: ";
    cin >> seatNo;

    if (seatNo < 1 || seatNo > TOTAL_SEATS)
    {
        cout << "Invalid seat number!\n";
        return;
    }

    if (seats[seatNo - 1] == 0)
    {
        cout << "This seat is already available.\n";
        return;
    }

    Passenger* current = *head;
    Passenger* previous = NULL;

    // Search for the passenger using the seat number
    while (current != NULL && current->seatNo != seatNo)
    {
        previous = current;
        current = current->next;
    }

    if (current == NULL)
    {
        cout << "Passenger record not found!\n";
        return;
    }

    // Remove the passenger from the linked list
    if (previous == NULL)
    {
        *head = current->next;
    }
    else
    {
        previous->next = current->next;
    }

    // Free the passenger node's memory
    free(current);

    // Mark the seat as available
    seats[seatNo - 1] = 0;

    cout << "Ticket cancelled successfully!\n";
}

// Function to display seat status
void viewTrainStatus(int* seats)
{
    cout << "\n===== TRAIN SEAT STATUS =====\n";

    for (int i = 0; i < TOTAL_SEATS; i++)
    {
        cout << "Seat " << i + 1 << ": ";

        if (seats[i] == 1)
        {
            cout << "Booked\n";
        }
        else
        {
            cout << "Available\n";
        }
    }
}

// Function to display passenger details
void viewPassengerList(Passenger* head)
{
    if (head == NULL)
    {
        cout << "No passengers have booked tickets.\n";
        return;
    }

    cout << "\n===== PASSENGER LIST =====\n";

    Passenger* current = head;

    while (current != NULL)
    {
        cout << "Seat No: " << current->seatNo
             << " | Name: " << current->name
             << " | Age: " << current->age
             << " | Gender: " << current->gender << "\n";

        current = current->next;
    }
}

// Function to release all allocated memory
void freeMemory(int* seats, Passenger* head)
{
    Passenger* current = head;

    while (current != NULL)
    {
        Passenger* temp = current;
        current = current->next;
        free(temp);
    }

    free(seats);
}
