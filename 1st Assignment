#include <iostream>
#include <string>
#include <cstdlib>
using namespace std;

const int TOTAL_SEATS = 30;

// Structure for passenger details
struct Passenger
{
    int seatNo;
    string name;
    int age;
    char gender;
    Passenger* next;
};

// Function declarations
void bookTicket(int* seats, Passenger** head);
void cancelTicket(int* seats, Passenger** head);
void viewTrainStatus(int* seats);
void viewPassengerList(Passenger* head);
void freeMemory(int* seats, Passenger* head);

int main()
{
    // Dynamically allocate memory for seats
    int* seats = (int*)malloc(TOTAL_SEATS * sizeof(int));

    if (seats == NULL)
    {
        cout << "Memory allocation failed!" << endl;
        return 1;
    }

    // Initially, all seats are available
    for (int i = 0; i < TOTAL_SEATS; i++)
    {
        seats[i] = 0;
    }

    Passenger* head = NULL;
    int choice;

    do
    {
        cout << "\n===== RAILWAY RESERVATION SYSTEM =====\n";
        cout << "1. Book Ticket\n";
        cout << "2. Cancel Ticket\n";
        cout << "3. View Train Status\n";
        cout << "4. View Passenger List\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                bookTicket(seats, &head);
                break;

            case 2:
                cancelTicket(seats, &head);
                break;

            case 3:
                viewTrainStatus(seats);
                break;

            case 4:
                viewPassengerList(head);
                break;

            case 5:
                freeMemory(seats, head);
                cout << "Thank you for using Railway Reservation System!\n";
                break;

            default:
                cout << "Invalid choice! Please try again.\n";
        }

    } while (choice != 5);

    return 0;
}

// Function to book a ticket
void bookTicket(int* seats, Passenger** head)
{
    int seatIndex = -1;

    // Find the first available seat
    for (int i = 0; i < TOTAL_SEATS; i++)
    {
        if (seats[i] == 0)
        {
            seatIndex = i;
            break;
        }
    }

    if (seatIndex == -1)
    {
        cout << "Sorry! All seats are booked.\n";
        return;
    }

    Passenger* newPassenger =
        (Passenger*)malloc(sizeof(Passenger));

